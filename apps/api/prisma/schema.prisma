generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
  OWNER
}

enum InventoryMovementType {
  SALE
  RESTOCK
  ADJUSTMENT
  RETURN
}

model Product {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String
  price       Decimal       @db.Decimal(12, 2)
  category    String
  image       String?
  sku         String        @unique
  stock       Int           @default(0)
  status      ProductStatus @default(DRAFT)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]

  @@index([category])
  @@index([status, isActive])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  firstName    String?
  lastName     String?
  role         UserRole  @default(CUSTOMER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orders      Order[]
  sessions    Session[]
  auditEvents AuditLog[] @relation("AuditActor")
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Order {
  id         String      @id @default(cuid())
  orderNo    String      @unique
  customerId String?
  customer   User?       @relation(fields: [customerId], references: [id])
  status     OrderStatus @default(PENDING)
  subtotal   Decimal     @db.Decimal(12, 2)
  shipping   Decimal     @default(0) @db.Decimal(12, 2)
  tax        Decimal     @default(0) @db.Decimal(12, 2)
  total      Decimal     @db.Decimal(12, 2)
  currency   String      @default("USD")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  items              OrderItem[]
  inventoryMovements InventoryMovement[]

  @@index([customerId])
  @@index([status, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  title     String
  sku       String
  unitPrice Decimal @db.Decimal(12, 2)
  quantity  Int

  @@index([orderId])
  @@index([productId])
}

model InventoryMovement {
  id           String                @id @default(cuid())
  productId    String
  product      Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderId      String?
  order        Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type         InventoryMovementType
  quantity     Int
  stockBefore  Int
  stockAfter   Int
  reason       String?
  createdAt    DateTime              @default(now())

  @@index([productId, createdAt])
  @@index([orderId])
  @@index([type, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entity, entityId])
}


model MerchantSettings {
  id           String   @id @default("default")
  storeName    String   @default("Market")
  supportEmail String?
  currency     String   @default("USD")
  locale       String   @default("en-US")
  logoUrl      String?
  primaryColor String   @default("#111827")
  taxRate      Decimal  @default(0) @db.Decimal(5, 4)
  shippingFee  Decimal  @default(0) @db.Decimal(12, 2)
  freeShippingThreshold Decimal? @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
