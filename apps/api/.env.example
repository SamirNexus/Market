NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://market:market@localhost:5432/market?schema=public
CORS_ORIGINS=http://localhost:4200,http://localhost:4201

# Replace with a long random value in every deployed environment.
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_SAME_SITE=lax

# Optional bootstrap owner created by the seed script when both are present.
OWNER_EMAIL=
OWNER_PASSWORD=

# Optional external payment gateway. Leave blank to keep Stripe disabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_SUCCESS_URL=http://localhost:4200/cart?payment=success
PAYMENT_CANCEL_URL=http://localhost:4200/cart?payment=cancelled
