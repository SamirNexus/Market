# Copy this file to an untracked .env file and replace every placeholder.

POSTGRES_DB=market
POSTGRES_USER=market
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# URL-encode special characters in the password used inside DATABASE_URL.
DATABASE_URL=postgresql://market:replace-with-url-encoded-password@postgres:5432/market?schema=public

PUBLIC_STOREFRONT_ORIGIN=https://shop.example.com
PUBLIC_ADMIN_ORIGIN=https://admin.example.com

JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_SAME_SITE=lax

STOREFRONT_PORT=8080
ADMIN_PORT=8081

# Optional one-time owner bootstrap values used only when running the seed command.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-unique-12-plus-character-password
