# Copy to an untracked .env file and replace every placeholder.
POSTGRES_DB=market
POSTGRES_USER=market
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://market:replace-with-url-encoded-password@postgres:5432/market?schema=public

PUBLIC_STOREFRONT_ORIGIN=https://shop.example.com
PUBLIC_ADMIN_ORIGIN=https://admin.example.com

JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_SAME_SITE=lax

# Keep manual until the external gateway account, HTTPS URLs, and webhook are verified.
PAYMENT_PROVIDER=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_SUCCESS_URL=https://shop.example.com/cart?payment=success
PAYMENT_CANCEL_URL=https://shop.example.com/cart?payment=cancelled

STOREFRONT_PORT=8080
ADMIN_PORT=8081

# Optional one-time owner bootstrap values.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-unique-12-plus-character-password
